# Ensure consistent line endings across OS
* text=auto eol=lf

# Explicitly set for common file types
*.cs     text diff=csharp
*.csproj text
*.sln    text
*.xml    text
*.json   text
*.yml    text
*.yaml   text
*.md     text
*.txt    text

# Binary files (no diff, no text conversion)
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.dll    binary
*.exe    binary
*.pdb    binary
*.zip    binary
*.tar    binary
*.gz     binary
*.nupkg  binary
*.snupkg binary

# License and documentation
LICENSE  text
README.md text

# GitHub linguist overrides (optional)
*.cs linguist-language=C#
